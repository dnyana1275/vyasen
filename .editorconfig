# EditorConfig is awesome: https://EditorConfig.org

root = true

[*]
indent_style = space
indent_size = 2
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
end_of_line = lf

[*.md]
# Markdown files often rely on trailing spaces for manual line breaks
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2